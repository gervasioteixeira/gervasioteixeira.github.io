---
layout: base.njk
titulo: Gervasio Teixeira — Dev Web
---
{% set icones = {
  eventos: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h3M8 18h3M14 14h2"/>',
  varejo: '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/>',
  saas: '<path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
  automacao: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  sites: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/>',
  educacao: '<path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>'
} %}
<section class="hero">
  <div class="rv">
    <span class="eyebrow"><i></i> Dev Web · Laravel · Vue · IA</span>
    <h1>Sistemas completos, do banco de dados à <span class="grad">interface</span>.</h1>
    <p class="lead">Sou Gervásio Teixeira, desenvolvedor full-stack e pesquisador em Ciência da Computação. Construo plataformas SaaS escaláveis, sistemas de gestão e automações inteligentes com IA. Unindo arquitetura sólida e código limpo, resolvo problemas reais através da tecnologia.</p>
    <div class="cta">
      <a class="btn primary" href="#projetos">Ver projetos →</a>
      <a class="btn ghost" href="/blog/">Ler o blog</a>
    </div>
  </div>
  <div class="term rv" aria-hidden="true">
    <div class="bar"><i></i><i></i><i></i></div>
    <div class="body" id="term" data-lines='["<span class=\"c\"># perfil</span>","<span class=\"k\">nome</span>   = <span class=\"v\">\"Gervasio Teixeira\"</span>","<span class=\"k\">stack</span>  = <span class=\"v\">[\"Laravel\", \"Vue\", \"n8n\"]</span>","<span class=\"k\">foco</span>   = <span class=\"v\">[\"offline-first\", \"multi-tenant\", \"IA\"]</span>","<span class=\"k\">status</span> = <span class=\"v\">\"construindo algo novo\"</span>"]'></div>
  </div>
</section>

<div class="stats rv">
  <div class="stat"><b data-count="20" data-suf="+">20+</b><span>projetos construídos</span></div>
  <div class="stat"><b data-count="6">6</b><span>áreas: eventos, varejo, SaaS, automação, educação, sites</span></div>
  <div class="stat"><b>Laravel · Vue</b><span>stack principal</span></div>
</div>

<section id="projetos">
  <div class="sec-head rv">
    <div><span class="kicker">Portfólio</span><h2>Projetos</h2></div>
    <div class="chips" role="group" aria-label="Filtrar projetos">
      <button class="chip" data-f="todos" aria-pressed="true">Todos</button>
      <button class="chip" data-f="eventos" aria-pressed="false">Eventos</button>
      <button class="chip" data-f="varejo" aria-pressed="false">Varejo</button>
      <button class="chip" data-f="saas" aria-pressed="false">SaaS</button>
      <button class="chip" data-f="automacao" aria-pressed="false">IA e automação</button>
      <button class="chip" data-f="educacao" aria-pressed="false">Educação</button>
      <button class="chip" data-f="sites" aria-pressed="false">Sites</button>
    </div>
  </div>
  <div class="grid">
    {% for p in projetos %}
    <article class="card rv{% if p.destaque %} feat{% endif %}" data-cat="{{ p.cat }}">
      <div class="ico"><svg viewBox="0 0 24 24">{{ icones[p.cat] | safe }}</svg></div>
      <span class="tag">{{ p.tag }}</span>
      <h3><a href="/projetos/{{ p.slug }}/">{{ p.nome }}</a></h3>
      <p>{{ p.texto }}</p>
      <div class="stack">{% for s in p.stack %}<span>{{ s }}</span>{% endfor %}</div>
      <span class="more">Ver detalhes →</span>
    </article>
    {% endfor %}
  </div>
</section>

<div class="marq rv" aria-hidden="true"><div>
  {% for i in [1,2] %}<span>Laravel</span><span>Vue 3</span><span>Livewire</span><span>Filament</span><span>React</span><span>Node</span><span>MySQL</span><span>n8n</span><span>Tailwind</span><span>Chrome MV3</span><span>Mercado Pago</span><span>QEMU</span>{% endfor %}
</div></div>

{% if collections.posts.length %}
<section>
  <div class="sec-head rv"><div><span class="kicker">Blog</span><h2>Últimos artigos</h2></div><a class="btn ghost" href="/blog/">Ver todos</a></div>
  <ul class="posts">
    {% for p in collections.posts | head(3) %}
    <li class="rv"><a href="{{ p.url }}">{{ p.data.title }}</a> <span class="meta">{{ p.date | dataBR }}</span><p>{{ p.data.resumo }}</p></li>
    {% endfor %}
  </ul>
</section>
{% endif %}
