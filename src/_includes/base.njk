<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ titulo or site.titulo }}</title>
<meta name="description" content="{{ descricao or site.descricao }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ titulo or site.titulo }}">
<meta property="og:description" content="{{ descricao or site.descricao }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/og.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#080b12">
<link rel="icon" href="/assets/icon.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="Blog" href="/feed.xml">
<link rel="preload" href="/assets/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter.woff2" as="font" type="font/woff2" crossorigin>
<script>try{var t=localStorage.getItem('tema')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');document.documentElement.setAttribute('data-theme',t)}catch(e){document.documentElement.setAttribute('data-theme','dark')}</script>
<link rel="stylesheet" href="/assets/style.css">
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"{{ site.nome }}","url":"{{ site.url }}","jobTitle":"Desenvolvedor web","sameAs":["https://instagram.com/{{ site.instagram }}"],"knowsAbout":["Laravel","Vue.js","Automação","Inteligência artificial"]}</script>
</head>
<body>
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="/"><span class="mono">GT</span><span class="bn">{{ site.nome }}</span></a>
    <nav class="links">
      <a href="/#projetos">Projetos</a>
      <a href="/blog/" class="keep">Blog</a>
      <a href="/sobre/" class="keep">Sobre</a>
      <a href="https://instagram.com/{{ site.instagram }}" rel="me" class="keep">Instagram</a>
      <button class="theme" type="button" aria-label="Alternar tema">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>
<main class="wrap">
{{ content | safe }}
<footer>
  <p>{{ site.aviso }}</p>
  <p>© {{ site.nome }} · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
</footer>
</main>
<button class="totop" type="button" aria-label="Voltar ao topo" hidden><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
<script src="/assets/site.js" defer></script>
</body>
</html>
